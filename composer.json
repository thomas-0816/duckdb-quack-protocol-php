{
    "name": "thomas-0816/duckdb-quack-protocol-php",
    "description": "PHP client for DuckDB Quack Remote Protocol, modern analytics",
    "keywords": ["duckdb", "database", "quack", "analytics"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "ergebnis/phpunit-slow-test-detector": "^2.27",
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "DuckDB\\Quack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DuckDB\\Quack\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "bash tests/run.sh",
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse --memory-limit=512M",
        "check": [
            "@cs:check",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
