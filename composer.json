{
    "name": "quack/quack-protocol",
    "description": "PHP client-side SDK for DuckDB's experimental Quack remote protocol",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Quack\\Protocol\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quack\\Protocol\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "bash tests/run.sh",
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse --memory-limit=512M",
        "check": [
            "@cs:check",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
